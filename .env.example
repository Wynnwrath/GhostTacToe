# Copy this to .env and fill in values
# Railway provides DATABASE_URL and PORT automatically

JWT_SECRET=your-64-character-random-secret-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CLIENT_URL=http://localhost:5173
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./ghosttactoe.db
